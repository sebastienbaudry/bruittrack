# Configuration BruitTrack
# Copier ce fichier vers config.toml et adapter selon votre matériel.

[audio]
# Nom ou index du périphérique PortAudio / ALSA (ex: "M-Track Plus", "hw:CARD=Plus,DEV=0", ou None pour défaut)
# Exécuter `python -m bruittrack devices` pour lister les périphériques disponibles.
device = ""

# Taux d'échantillonnage de capture (Hz)
sample_rate = 48000

# Facteur de décimation exacte (48000 / 48 = 1000 Hz)
decimation = 48

# Taille de bloc brut à 48 kHz (4800 = 100 ms)
block_size = 4800

# Nombre de canaux (IN1: Air, IN2: Structure)
channels = 2

[dsp]
# Taille des sous-segments pour Welch à 1000 Hz (2048 pts = 2.048 s => résolution ~0.488 Hz/bin)
n_seg = 2048

# Recouvrement des segments Welch (1024 pts = 50%)
noverlap = 1024

# Taille du tampon glissant basse fréquence (8192 pts = 8.192 s, 7 segments Welch)
n_buffer = 8192

# Fréquence maximale d'analyse et de détection (Hz) — défaut 150.0
freq_max = 150.0

# Borne basse des événements (Hz) : le matériel n'est pas fiable sous ~2 Hz ;
# les bins détectables couvrent [min_event_hz .. freq_max] (cf. docs/decision-log.md)
min_event_hz = 2.0

# Facteur de lissage exponentiel temporel (0 = lissage max, 1 = pas de lissage)
ema_alpha = 0.5

# Nombre de blocs pour le calcul de la médiane glissante du bruit de fond (300 blocs = 30 s)
floor_history_len = 300

# Fréquence de coupure du filtre passe-bas anti-repliement (Hz)
lp_cutoff_hz = 400.0

[detector]
# Seuil d'émergence en dB au-dessus du plancher de bruit pour déclencher un événement
threshold_db = 10.0

# Hystérésis en dB pour relâcher l'événement (arrêt si émergence < seuil - hysteresis)
hysteresis_db = 3.0

# Durée minimale requise (en blocs de 100 ms) avant de valider l'événement (5 = 0.5 s)
debounce_ticks = 5

# Durée maximale d'un segment d'événement avant découpage forcé (secondes)
max_duration_s = 30.0

# Nombre de blocs d'échauffement au démarrage avant d'autoriser les détections (300 = 30 s)
warmup_ticks = 300

# Tolerance de frequence (Hz) pour fusionner des evenements dans le meme cluster,
# sur le bin dominant (convertie en bins : round(tol / 0.48828125))
cluster_freq_tolerance_hz = 2.0

[storage]
# Chemin de la base de données SQLite
db_path = "data/bruittrack.db"

# Répertoire de stockage des extraits audio exemplaires (256 ms @ 1kHz)
exemplars_dir = "exemplars"

# Nombre d'événements à accumuler en mémoire avant écriture SQLite
batch_size = 50

# Délai maximal (secondes) avant vidage forcé du lot d'événements vers SQLite
batch_timeout_s = 30.0

# Activer l'enregistrement des extraits audio exemplaires (256 ms, ex_nnn.raw).
# false = aucun fichier audio n'est écrit, et le lecteur disparaît de la viz.
record_exemplars = true

# Rétention des données en jours (0 ou null = conservation infinie)
retention_days = 365

[spectrum]
# Historique spectre basse fréquence : bandes log-spacées sur
# [min_event_hz .. freq_max], 1 ligne/interval_s avec min/max quantifiés uint8
# par bande et canal (cf. docs/decision-log.md). Rend visible un signal infra
# quasi permanent, absorbé par le plancher et donc jamais détecté en événement.

# Activer la collecte et la table spectrum
enabled = true

# Durée d'agrégation par ligne (60 s ≈ 40 Mo/an sur le SSD T620)
interval_s = 60.0

# Nombre de bandes log-spacées (24 ≈ 20% de largeur par bande)
n_bands = 24

# Fenêtre de quantification uint8 des niveaux PSD en dB :
# q = clip(round((db - db_min) / db_range * 255), 0, 255)
db_min = -60.0
db_range = 120.0

# Rétention dédiée de la table spectrum en jours (0 = infinie ; la table suit
# sinon sa propre durée de conservation, indépendante des événements)
retention_days = 0

[viz]
# Adresse IP d'écoute du serveur web léger
host = "0.0.0.0"

# Port d'écoute du serveur web
port = 8760
